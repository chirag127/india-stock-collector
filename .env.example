# Copy to .env (local only, never commit). All values empty by default = paper mode.
# Shoonya OAuth credentials — local ignored file only. Never commit.
SHOONYA_CLIENT_ID=
SHOONYA_SECRET_CODE=
SHOONYA_UID=
SHOONYA_API_KEY=
# OAuth tokens are written back to local cred.yml (ignored), not here.
# Live trading master switch. Default empty/false = impossible.
LIVE_TRADING_ENABLED=
# Broker-whitelisted static IP expectation (informational guard, verified at runtime).
SHOONYA_WHITELISTED_IP=
# Local sqlite path (default data/app.db, ignored by git).
APP_DB_PATH=data/app.db
APP_HOST=127.0.0.1
APP_PORT=8000
